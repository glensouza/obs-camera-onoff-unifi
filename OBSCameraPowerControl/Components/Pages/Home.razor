@page "/"
@using OBSCameraPowerControl.Models
@using OBSCameraPowerControl.Services
@inject UniFiService UniFiService
@implements IDisposable

<PageTitle>Camera Control Panel</PageTitle>

<div class="container">
    <h1>Camera Control Panel</h1>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="status-message @statusCssClass">@statusMessage</div>
    }

    <div class="camera-grid">
        @if (isLoading)
        {
            <div class="loading">Loading camera status</div>
        }
        else if (monitoredStatuses.Count == 0)
        {
            <div class="no-cameras">
                <p>No cameras selected for monitoring.</p>
                <p>Use the <strong>Add Camera</strong> dropdown below to get started.</p>
            </div>
        }
        else
        {
            @foreach (PortStatus port in monitoredStatuses.OrderBy(p => p.PortNumber))
            {
                <div class="camera-card @(port.PoeEnabled ? "active" : "inactive")">
                    <div class="camera-header">
                        <div class="camera-name">@port.PortName</div>
                        <div class="camera-header-actions">
                            <label class="toggle-switch">
                                <input type="checkbox"
                                       checked="@port.PoeEnabled"
                                       disabled="@(isMasterToggling || togglingPorts.Contains(port.PortNumber) || isLoading)"
                                       @onchange="e => HandleToggleAsync(port.PortNumber, (bool)(e.Value ?? false))" />
                                <span class="slider"></span>
                            </label>
                            <button class="btn-delete" title="Remove from panel"@onclick="() => RemovePort(port.PortNumber)">✕</button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="footer">
        @if (monitoredStatuses.Count > 0)
        {
            <div class="master-switch-section">
                <label class="toggle-switch">
                    <input type="checkbox"
                           checked="@AllMonitoredOn"
                           disabled="@(isMasterToggling || isLoading)"
                           @onchange="e => HandleMasterToggleAsync((bool)(e.Value ?? false))" />
                    <span class="slider"></span>
                </label>
                <span class="master-label">Master</span>
            </div>
        }

        <br />
        <button class="btn-refresh" @onclick="RefreshAllAsync" disabled="@isLoading">Refresh All</button>

        @if (availablePorts.Count > 0)
        {
            <br />
            <div class="add-camera-section">
                <select @bind="selectedPortNumber">
                    <option value="0">-- Select a port --</option>
                    @foreach (PortStatus port in availablePorts.OrderBy(p => p.PortNumber))
                    {
                        <option value="@port.PortNumber">Port @port.PortNumber</option>
                    }
                </select>
                <button class="btn-add" @onclick="AddSelectedPort" disabled="@(selectedPortNumber == 0)">Add Camera</button>
            </div>
        }
    </div>
</div>

@code {
    private List<PortStatus> allPortStatuses = [];
    private List<PortStatus> monitoredStatuses = [];
    private List<PortStatus> availablePorts = [];
    private readonly HashSet<int> togglingPorts = [];
    private bool isMasterToggling = false;
    private bool isLoading = true;
    private string? statusMessage;
    private string statusCssClass = string.Empty;
    private Timer? refreshTimer;
    private CancellationTokenSource? statusClearCts;
    private int selectedPortNumber;

    protected override async Task OnInitializedAsync()
    {
        await LoadPortStatusesAsync();
        refreshTimer = new Timer(async _ => await InvokeAsync(async () =>
        {
            await LoadPortStatusesAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(20), TimeSpan.FromSeconds(20));
    }

    private async Task LoadPortStatusesAsync()
    {
        try
        {
            allPortStatuses = await UniFiService.GetAllPortsStatusAsync();
            UpdateFilteredLists();
        }
        catch (Exception ex)
        {
            ShowStatus($"Error loading port statuses: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdateFilteredLists()
    {
        IReadOnlySet<int> monitored = UniFiService.MonitoredPorts;
        monitoredStatuses = allPortStatuses.Where(p => monitored.Contains(p.PortNumber)).ToList();
        availablePorts = allPortStatuses.Where(p => !monitored.Contains(p.PortNumber)).ToList();
    }

    private void AddSelectedPort()
    {
        if (selectedPortNumber == 0)
        {
            return;
        }

        UniFiService.AddMonitoredPort(selectedPortNumber);
        PortStatus? port = allPortStatuses.FirstOrDefault(p => p.PortNumber == selectedPortNumber);
        ShowStatus($"Added {port?.PortName ?? $"Port {selectedPortNumber}"} to panel", "success");
        selectedPortNumber = 0;
        UpdateFilteredLists();
    }

    private void RemovePort(int portNumber)
    {
        UniFiService.RemoveMonitoredPort(portNumber);
        PortStatus? port = allPortStatuses.FirstOrDefault(p => p.PortNumber == portNumber);
        ShowStatus($"Removed {port?.PortName ?? $"Port {portNumber}"} from panel", "success");
        UpdateFilteredLists();
    }

    private async Task RefreshAllAsync()
    {
        ShowStatus("Refreshing...", "info");
        isLoading = true;
        await LoadPortStatusesAsync();
    }

    private async Task HandleToggleAsync(int portNumber, bool enable)
    {
        if (isMasterToggling)
        {
            ShowStatus("Master operation in progress; try individual toggles later.", "info");
            return;
        }

        togglingPorts.Add(portNumber);
        ShowStatus($"{(enable ? "Enabling" : "Disabling")} port {portNumber}...", "info");

        try
        {
            bool success = await UniFiService.SetPortStateAsync(portNumber, enable);

            if (success)
            {
                ShowStatus($"Port {portNumber} {(enable ? "enabled" : "disabled")}", "success");
            }
            else
            {
                ShowStatus($"Failed to {(enable ? "enable" : "disable")} port {portNumber}", "error");
            }

            // Refresh status after a short delay to let the switch apply changes
            await Task.Delay(1000);
            await LoadPortStatusesAsync();
        }
        catch (Exception ex)
        {
            ShowStatus($"Error toggling port {portNumber}: {ex.Message}", "error");
        }
        finally
        {
            togglingPorts.Remove(portNumber);
        }
    }

    private bool AllMonitoredOn => monitoredStatuses.Count > 0 && monitoredStatuses.All(p => p.PoeEnabled);

    private async Task HandleMasterToggleAsync(bool enable)
    {
        if (monitoredStatuses.Count == 0)
        {
            ShowStatus("No monitored ports to change.", "info");
            return;
        }

        isMasterToggling = true;
        ShowStatus($"{(enable ? "Enabling" : "Disabling")} all monitored ports...", "info");

        try
        {
            IEnumerable<int> ports = monitoredStatuses.Select(p => p.PortNumber);
            bool success = await UniFiService.SetPortsStateAsync(ports, enable);

            if (success)
            {
                ShowStatus($"All monitored ports {(enable ? "enabled" : "disabled")}", "success");
            }
            else
            {
                ShowStatus($"Failed to {(enable ? "enable" : "disable")} monitored ports", "error");
            }

            await Task.Delay(1000);
            await LoadPortStatusesAsync();
        }
        catch (Exception ex)
        {
            ShowStatus($"Error toggling monitored ports: {ex.Message}", "error");
        }
        finally
        {
            isMasterToggling = false;
        }
    }

    private void ShowStatus(string message, string type)
    {
        statusClearCts?.Cancel();
        statusMessage = message;
        statusCssClass = type;

        if (type == "error")
        {
            return;
        }

        statusClearCts = new CancellationTokenSource();
        CancellationToken token = statusClearCts.Token;
        _ = Task.Delay(3000, token).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                statusMessage = null;
                statusCssClass = string.Empty;
                StateHasChanged();
            });
        }, TaskContinuationOptions.NotOnCanceled);
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
        statusClearCts?.Cancel();
        statusClearCts?.Dispose();
    }
}
